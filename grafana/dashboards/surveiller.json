        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sort_desc(avg_over_time(surveiller_target_rtt_ms{instance=~\"${instance}\", target=~\"${target}\", group=~\"${group}\"}[$__range]))",
